# Copy to .env and fill in. Never commit .env.
# Every variable is optional; defaults are shown in comments.

# Database (any SQLAlchemy URL). Default: local SQLite file data/warehouse/fashion_intel.db
# PostgreSQL example (use your own user, password and database):
# DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@localhost:5432/fashion_intel
DATABASE_URL=

# Raw export to process. Default: data/raw/apify_raw.csv
RAW_INPUT_PATH=

# Audit window: length in days (default 60) and end date YYYY-MM-DD (default: newest post)
AUDIT_WINDOW_DAYS=
AUDIT_WINDOW_END=

# Only needed if you collect new data with Apify yourself. Not used by the pipeline.
APIFY_TOKEN=
